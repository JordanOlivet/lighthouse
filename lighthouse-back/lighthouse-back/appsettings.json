{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Data Source=/app/data/app.db"
  },
  "Jwt": {
    "Secret": "CHANGE-THIS-SECRET-KEY-IN-PRODUCTION-MIN-32-CHARS",
    "Issuer": "lighthouse",
    "Audience": "lighthouse-client",
    "ExpirationMinutes": 15,
    "RefreshExpirationDays": 1,
    "RefreshExpirationDaysExtended": 30
  },
  "Docker": {
    "Host": "unix:///var/run/docker.sock"
  },
  "Cors": {
    "Origins": ["http://localhost:3030"]
  },
  "Security": {
    "PasswordHashing": {
      "WorkFactor": 12
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/app-.clef",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "ComposeDiscovery": {
    "RootPath": "/app/compose-files",
    "ScanDepthLimit": 5,
    "CacheDurationSeconds": 300,
    "MaxFileSizeKB": 1024
  },
  "SelfUpdate": {
    "Enabled": true,
    "ComposeFilePath": null,
    "CheckIntervalHours": 24,
    "GitHubRepo": "JordanOlivet/lighthouse",
    "AllowPreRelease": false,
    "CacheDurationSeconds": 3600,
    "GitHubApiBaseUrl": "https://api.github.com",
    "GitHubAccessToken": null,
    "DockerImageName": "ghcr.io/jordanolivet/lighthouse"
  },
  "Maintenance": {
    "ReconnectInitialIntervalMs": 3000,
    "ReconnectMaxIntervalMs": 15000,
    "ReconnectMaxAttempts": 60,
    "ReconnectBackoffMultiplier": 1.5,
    "GracePeriodSeconds": 5
  },
  "UpdateCheck": {
    "Enabled": true,
    "CacheDurationMinutes": 720,
    "MaxConcurrentChecks": 5,
    "TimeoutSeconds": 30,
    "RetryAttempts": 3,
    "ExcludedProjects": [],
    "ExcludedImages": [],
    "CheckIntervalMinutes": 720,
    "StartupDelaySeconds": 10,
    "PullRetryAttempts": 4,
    "PullRetryBaseDelaySeconds": 5,
    "PullRetryMaxDelaySeconds": 60,
    "PullRetryJitterFactor": 0.2,
    "AutoUpdateProjectDelaySeconds": 3,
    "AutoUpdateRateLimitRetryDelaySeconds": 300
  },
  "Email": {
    "Provider": "Mock",
    "FromEmail": "",
    "FromName": "",
    "AppBaseUrl": "http://localhost:3030",
    "MockLogPath": "/app/logs/emails",
    "Resend": {
      "ApiKey": null
    }
  },
  "PasswordReset": {
    "TokenExpirationMinutes": 15,
    "MaxActiveTokensPerUser": 3,
    "CleanupIntervalHours": 1
  }
}
